# Copy this file to .env and provide deployment-specific values.
DJANGO_ENV=development
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=
CELERY_TASK_DEFAULT_QUEUE=pendeza_connect
MOMO_PAYMENT_INITIATION_ENABLED=false

# Local Firebase Admin: point to a replacement JSON key outside the repository.
FIREBASE_PROJECT_ID=pendezaconnect
GOOGLE_APPLICATION_CREDENTIALS=D:/PERPETUAL SECRETS/pendezaconnect-firebase-admin.json

# Railway alternative: set this as a private Railway variable instead of a file path.
FIREBASE_SERVICE_ACCOUNT_B64=
